# --- Секреты и генерируемые конфиги ---
# .env создаётся start-docker.bat из корневого config.txt
.env
# корневой config.txt (шаблон — config.example.txt)
# и php/config.txt, который init-контейнер перезаписывает на каждом up
config.txt
# ngrok/ngrok.yml удалён: authtoken идёт через .env, файл compose не использовал.
# Правило оставлено на случай, если ngrok сгенерирует его заново.
ngrok/

# --- Логи ---
*.log

# --- Зависимости (composer install внутри контейнера php) ---
php/vendor/

# --- Кэш скомпилированных шаблонов Smarty ---
php/src/App/templates_c/*
!php/src/App/templates_c/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]

# --- IDE ---
.idea/
.vscode/

# --- Рабочая память агентов ---
.claude/
.cursor/
CLAUDE.md
