# config.txt локально генерирует контейнер init. Попав в образ, он перебил бы
# чтение настроек из окружения — в проде файла быть не должно.
config.txt

# vendor ставится внутри образа через composer install. Копировать хостовый
# бессмысленно (его тут же перезапишут) и дорого: на 1 GB инстансе это минуты.
vendor/

# Незачем в образе
.dockerignore
Dockerfile
data/
database/migrations/
