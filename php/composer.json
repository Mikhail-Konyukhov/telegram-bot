{
    "require": {
        "php": "^8.2",
        "telegram-bot/api": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.4",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:e2e": "phpunit --testsuite e2e"
    },
    "config": {
        "platform": {
            "php": "8.2.0",
            "ext-sockets": "8.2.0"
        }
    }
}
