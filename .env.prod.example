# Шаблон прод-.env. На сервере: скопировать в .env, заполнить, chmod 600 .env
#
#   cp .env.prod.example .env && chmod 600 .env
#
# Это НЕ корневой config.txt — тот нужен только Windows-обвязке start-docker.bat
# для локальной разработки и на сервере не используется вообще.

# Поддомен, на который смотрит A-запись DuckDNS. Без схемы и без слэша.
PUBLIC_DOMAIN=example.duckdns.org

# @BotFather. Отдельный бот от локального: webhook у бота ровно один,
# и прод с локалкой будут перебивать друг друга.
TELEGRAM_BOT_TOKEN=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Минимальная пауза между обращениями к Gemini, миллисекунды. Ключ один на всех
# пользователей, и лимит у него на ключ — темп держит воркер очереди, выдерживая
# этот интервал. Выставить под свой тариф; 0 снимает ограничение.
# Пусто — берётся 4000 (15 запросов в минуту).
GEMINI_MIN_INTERVAL_MS=

# Direct link Mini App — нужен только для групп: кнопки web_app Telegram
# в группах не показывает вообще. Заводится у @BotFather: /newapp, выбрать бота,
# задать короткое имя. Результат вида https://t.me/ваш_бот/app — сюда без слэша
# на конце и без ?startapp=, его бот подставит сам.
# Пусто — приложение работает только в личных чатах.
MINIAPP_LINK=

# Пароль root для MySQL. Длинный случайный, например:
#   openssl rand -base64 24
# Задаётся при первом создании тома mysql_data; позже смена значения здесь
# пароль в базе НЕ поменяет — только сломает подключение.
MYSQL_ROOT_PASSWORD=
